FROM node:22-alpine

# Build context is the repo root (not apps/marketing) — required so this
# Dockerfile can see the workspace-level pnpm-lock.yaml/pnpm-workspace.yaml.
# See docker-compose.dev.yml: context: . / dockerfile: apps/marketing/Dockerfile.dev
WORKDIR /repo

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN pnpm install --frozen-lockfile

WORKDIR /repo/apps/marketing

# Source is mounted at runtime via docker-compose.dev.yml — no COPY . .
# "pnpm dev" runs `next dev -p 3001` (see package.json) so it doesn't clash
# with the dashboard app's port 3000 when both run natively/side-by-side.
EXPOSE 3001
CMD ["pnpm", "dev"]
