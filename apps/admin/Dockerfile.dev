FROM node:22-alpine

# Build context is the repo root (not apps/admin) — required so this
# Dockerfile can see the workspace-level pnpm-lock.yaml/pnpm-workspace.yaml.
# See docker-compose.dev.yml: context: . / dockerfile: apps/admin/Dockerfile.dev
WORKDIR /repo

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN pnpm install --frozen-lockfile

WORKDIR /repo/apps/admin

# Source is mounted at runtime via docker-compose.dev.yml — no COPY . .
EXPOSE 3002
CMD ["pnpm", "dev"]
