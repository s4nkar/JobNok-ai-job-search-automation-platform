# ── AI Provider ──────────────────────────────────────────────────────────
AI_PROVIDER=groq
AI_FALLBACK_CHAIN=openrouter
AI_REQUEST_TIMEOUT_SECONDS=60
PROMPT_PARSE_CACHE_TTL_SECONDS=3600

# Groq (OpenAI-compatible) — https://console.groq.com
GROQ_API_KEY=
# Verify against your account's catalog: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_LIGHT_MODEL=allam-2-7b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (OpenAI-compatible) — sole fallback — https://openrouter.ai
OPENROUTER_API_KEY=
# Free-tier models can get congested — verify at https://openrouter.ai/api/v1/models
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Embedding Providers ──────────────────────────────────────────────────
EMBEDDING_PROVIDER=jina
EMBEDDING_FALLBACK_CHAIN=cohere
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
JINA_BASE_URL=https://api.jina.ai/v1

COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_BASE_URL=https://api.cohere.com/v2

# ── Rate Limits (per-user/day unless noted) ─────────────────────────────
RATE_LIMIT_LINKEDIN_PER_DAY=10
RATE_LIMIT_RESUME_AI_PER_DAY=8
RATE_LIMIT_RESUME_PDF_PER_DAY=20
RATE_LIMIT_COVER_LETTER_PER_DAY=5
RATE_LIMIT_INTERVIEW_PER_DAY=10
RATE_LIMIT_SALARY_PER_DAY=5
RATE_LIMIT_JOB_SEARCH_PER_DAY=10
RATE_LIMIT_JOB_SEARCH_APPLICATIONS_PER_DAY=200
RATE_LIMIT_STARTUP_HUNT_PER_DAY=8
RATE_LIMIT_BULK_EMAIL_PER_CAMPAIGN=500
RATE_LIMIT_BULK_EMAIL_PER_MONTH=3000

# ── LinkedIn Scraping ────────────────────────────────────────────────────
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_HOST=linkedin-api8.p.rapidapi.com
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=
LINKEDIN_SESSION_COOKIE=
LINKEDIN_CACHE_TTL_DAYS=7

# ── Job Search — providers ──────────────────────────────────────────────
JOB_SEARCH_ADZUNA_ENABLED=true
JOB_SEARCH_BUNDESAGENTUR_ENABLED=true
JOB_SEARCH_ARBEITNOW_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api
JOB_SEARCH_TIMEOUT_SECONDS=12
JOB_SEARCH_CACHE_TTL_DAYS=14
JOB_SEARCH_RESPONSE_CACHE_TTL_SECONDS=900
JOB_SEARCH_MAX_TRACKED_HISTORY=2000
JOB_SEARCH_APPLICATIONS_PAGE_SIZE_DEFAULT=50
JOB_SEARCH_APPLICATIONS_PAGE_SIZE_MAX=200

# ── Startup Hunt ─────────────────────────────────────────────────────────
STARTUP_HUNT_TIMEOUT_SECONDS=20
STARTUP_HUNT_APIFY_POLL_SECONDS=60
STARTUP_HUNT_TOTAL_BUDGET_SECONDS=30
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_STARTUP_HUNT_ACTOR_ID=
APIFY_INDEED_ACTOR_ID=
THEIRSTACK_API_KEY=
THEIRSTACK_BASE_URL=https://api.theirstack.com
THEIRSTACK_MAX_PAGE_SIZE=25
STARTUP_HUNT_CONTACT_ENRICHMENT_PROVIDER=
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
CRUNCHBASE_API_KEY=

# ── Bulk Email ───────────────────────────────────────────────────────────
BULK_EMAIL_MIN_DELAY_SECONDS=20
BULK_EMAIL_SENDS_PER_SECOND=5

# ── Cloudinary (required) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Clerk / Auth (required) ──────────────────────────────────────────────
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# ── Database (required) ──────────────────────────────────────────────────
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

# ── Upstash Redis (required) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:6379/0

# ── Resend ───────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@jobnok.app
RESEND_FROM_NAME=JobNok

# ── App ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3002

# ── Default Admin ────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_CLERK_USER_ID=

BACKEND_API_SECRET=

# ── Sentry (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
