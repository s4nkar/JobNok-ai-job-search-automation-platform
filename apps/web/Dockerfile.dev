FROM node:22-alpine

# Build context is the repo root (not apps/web) — required so this Dockerfile
# can see the workspace-level pnpm-lock.yaml/pnpm-workspace.yaml. See
# docker-compose.dev.yml: context: . / dockerfile: apps/web/Dockerfile.dev
WORKDIR /repo

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN pnpm install --frozen-lockfile

WORKDIR /repo/apps/web

# Source is mounted at runtime via docker-compose.dev.yml — no COPY . .
EXPOSE 3000
CMD ["pnpm", "dev"]
