# ── AI Provider ──────────────────────────────────────────────────────────────
# "anthropic" or "huggingface"
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional — leave empty to use free anonymous HuggingFace inference
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get all three from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Get from: https://console.upstash.com > Redis > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Redis (Celery broker) ─────────────────────────────────────────────────────
# Docker: redis://:${REDIS_PASSWORD}@redis:6379/0
# Local:  redis://localhost:6379/0
REDIS_URL=redis://:changeme@redis:6379/0
REDIS_PASSWORD=changeme

# ── LinkedIn Scraping ─────────────────────────────────────────────────────────
# Primary: https://rapidapi.com/hub — search "LinkedIn API"
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_HOST=linkedin-api8.p.rapidapi.com
# Fallback (optional)
PHANTOMBUSTER_API_KEY=

# ── Resend (bulk email) ───────────────────────────────────────────────────────
# https://resend.com > API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=QuickJob

# ── App ───────────────────────────────────────────────────────────────────────
# Production: your public domain. Dev: http://localhost:3000
APP_URL=http://localhost:3000

# Optional: shared secret between nginx and FastAPI (defence-in-depth).
# Leave empty in Docker deployments — network isolation is the guard.
BACKEND_API_SECRET=

# ── Rate Limits (per-user per-day) ────────────────────────────────────────────
RATE_LIMIT_LINKEDIN_PER_DAY=10
RATE_LIMIT_RESUME_PER_DAY=5
RATE_LIMIT_COVER_LETTER_PER_DAY=5
RATE_LIMIT_INTERVIEW_PER_DAY=10
RATE_LIMIT_SALARY_PER_DAY=5
RATE_LIMIT_BULK_EMAIL_PER_CAMPAIGN=500
RATE_LIMIT_BULK_EMAIL_PER_MONTH=3000

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
