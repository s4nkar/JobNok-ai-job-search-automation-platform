# ============================================================
# QuickJob Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# AI PROVIDER — switch between anthropic and huggingface
# ============================================================
AI_PROVIDER=HuggingFace
# AI model for the selected provider:
#   Anthropic:   claude-sonnet-4-6 | claude-haiku-4-5-20251001 | claude-opus-4-7
#   HuggingFace: mistralai/Mistral-7B-Instruct-v0.3 | HuggingFaceH4/zephyr-7b-beta
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace (only needed when AI_PROVIDER=huggingface)
# Leave HUGGINGFACE_API_KEY empty to use the free anonymous inference API
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Max tokens for HuggingFace generation
HUGGINGFACE_MAX_TOKENS=2048

# ============================================================
# RATE LIMITS — enforced server-side via Redis
# Must match frontend .env NEXT_PUBLIC_RATE_LIMIT_* values
# ============================================================
RATE_LIMIT_LINKEDIN_PER_DAY=10
RATE_LIMIT_RESUME_PER_DAY=5
RATE_LIMIT_COVER_LETTER_PER_DAY=5
RATE_LIMIT_INTERVIEW_PER_DAY=10
RATE_LIMIT_SALARY_PER_DAY=5
RATE_LIMIT_JOB_SEARCH_PER_DAY=10
RATE_LIMIT_BULK_EMAIL_PER_CAMPAIGN=500
RATE_LIMIT_BULK_EMAIL_PER_MONTH=3000

# ============================================================
# LINKEDIN SCRAPING
# ============================================================
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_HOST=
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=
LINKEDIN_SESSION_COOKIE=
LINKEDIN_CACHE_TTL_DAYS=7

# ============================================================
# RECENT JOB SEARCH
# JSON array of direct ATS sources used by /recent-job-search
# Example:
# JOB_SEARCH_SOURCES_JSON=[{"type":"greenhouse","name":"Acme Careers","slug":"acme","company":"Acme","metadata":{"stage":"seed","languages":["english"],"country":"germany"}}]
# ============================================================
JOB_SEARCH_SOURCES_JSON=[]
JOB_SEARCH_TIMEOUT_SECONDS=12

# ============================================================
# BULK EMAIL
# ============================================================
BULK_EMAIL_MIN_DELAY_SECONDS=20

# ============================================================
# SUPABASE
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ============================================================
# UPSTASH REDIS (rate limiting, LinkedIn cache)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Full Redis URL for Celery broker
REDIS_URL=
REDIS_PASSWORD=

# ============================================================
# RESEND (email sending)
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# ============================================================
# APP
# ============================================================
APP_URL=http://localhost:3000
# Shared secret validated on every request from the Next.js frontend
BACKEND_API_SECRET=

# ============================================================
# SENTRY (optional)
# ============================================================
SENTRY_DSN=
