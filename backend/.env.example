# ============================================================
# QuickJob Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# AI PROVIDER — switch between anthropic and huggingface
# ============================================================
AI_PROVIDER=HuggingFace
# AI model for the selected provider:
#   Anthropic:   claude-sonnet-4-6 | claude-haiku-4-5-20251001 | claude-opus-4-7
#   HuggingFace: mistralai/Mistral-7B-Instruct-v0.3 | HuggingFaceH4/zephyr-7b-beta
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace (only needed when AI_PROVIDER=huggingface)
# Leave HUGGINGFACE_API_KEY empty to use the free anonymous inference API
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Max tokens for HuggingFace generation
HUGGINGFACE_MAX_TOKENS=2048

# ============================================================
# RATE LIMITS — enforced server-side via Redis
# Must match frontend .env NEXT_PUBLIC_RATE_LIMIT_* values
# ============================================================
RATE_LIMIT_LINKEDIN_PER_DAY=10
RATE_LIMIT_RESUME_PER_DAY=5
RATE_LIMIT_COVER_LETTER_PER_DAY=5
RATE_LIMIT_INTERVIEW_PER_DAY=10
RATE_LIMIT_SALARY_PER_DAY=5
RATE_LIMIT_JOB_SEARCH_PER_DAY=10
RATE_LIMIT_STARTUP_HUNT_PER_DAY=8
RATE_LIMIT_BULK_EMAIL_PER_CAMPAIGN=500
RATE_LIMIT_BULK_EMAIL_PER_MONTH=3000

# ============================================================
# LINKEDIN SCRAPING
# ============================================================
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_HOST=
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=
LINKEDIN_SESSION_COOKIE=
LINKEDIN_CACHE_TTL_DAYS=7

# ============================================================
# RECENT JOB SEARCH
# JSON array of direct ATS sources used by /recent-job-search
# Example:
# JOB_SEARCH_SOURCES_JSON=[{"type":"greenhouse","name":"Acme Careers","slug":"acme","company":"Acme","metadata":{"stage":"seed","languages":["english"],"country":"germany"}}]
# ============================================================
JOB_SEARCH_SOURCES_JSON=[]
JOB_SEARCH_TIMEOUT_SECONDS=12

# ============================================================
# STARTUP HUNT
# Supports ATS sources plus startup lead sources:
# [{"type":"ashby","name":"Synthflow Jobs","slug":"synthflow","company":"Synthflow AI","metadata":{"stage":"seed","city":"berlin","country":"germany","english_friendly":true,"company_website_url":"https://synthflow.ai","careers_url":"https://jobs.ashbyhq.com/synthflow"}}]
# [{"type":"greenhouse","name":"Acme Careers","slug":"acme","company":"Acme","metadata":{"stage":"seed","city":"berlin","country":"germany","english_friendly":true,"company_website_url":"https://acme.com"}}]
# [{"type":"startup_company","name":"StartupMap Lead","company":"Acme","url":"https://acme.com","metadata":{"stage":"pre-seed","city":"berlin","country":"germany","english_friendly":true,"ai_relevance":"ai infrastructure","contacts":[{"name":"Jane Doe","title":"Founder","email":"jane@acme.com"}]}}]
# [{"type":"startup_directory","name":"StartupMap Germany","company":"startupmap","url":"https://startupmap.one/startups","metadata":{"country":"germany","city":"berlin","company_link_patterns":["/startups/"],"english_friendly":true,"default_stage":"seed"}}]
# [{"type":"apify_actor","name":"Apify Startup Discovery","company":"apify","metadata":{"actor_id":"your-actor-id","actor_output_type":"startup_hunt_v1"}}]
# [{"type":"indeed_search","name":"Indeed Discovery","company":"indeed","metadata":{"actor_id":"your-indeed-actor-id","actor_output_type":"indeed_v1"}}]
# ============================================================
STARTUP_HUNT_SOURCES_JSON=[]
STARTUP_HUNT_TIMEOUT_SECONDS=15
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
# Generic Apify actor for startup/job search discovery
APIFY_STARTUP_HUNT_ACTOR_ID=
# Optional Indeed-specific Apify actor for listing discovery
APIFY_INDEED_ACTOR_ID=
# Optional contact enrichment: apollo | pdl
STARTUP_HUNT_CONTACT_ENRICHMENT_PROVIDER=
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
THEIRSTACK_API_KEY=your_theirstack_api_key_here
THEIRSTACK_BASE_URL=https://api.theirstack.com


# ============================================================
# BULK EMAIL
# ============================================================
BULK_EMAIL_MIN_DELAY_SECONDS=20

# ============================================================
# SUPABASE
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ============================================================
# UPSTASH REDIS (rate limiting, LinkedIn cache)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Full Redis URL for Celery broker
REDIS_URL=
REDIS_PASSWORD=

# ============================================================
# RESEND (email sending)
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# ============================================================
# APP
# ============================================================
APP_URL=http://localhost:3000
# Shared secret validated on every request from the Next.js frontend
BACKEND_API_SECRET=

# ============================================================
# SENTRY (optional)
# ============================================================
SENTRY_DSN=
